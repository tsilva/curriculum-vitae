{
  "name": "cv-tsilva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python3 ../scripts/infisical/run.py dev",
    "build": "export GIT_COMMIT_HASH=$([ -n \"$VERCEL_GIT_COMMIT_SHA\" ] && echo \"${VERCEL_GIT_COMMIT_SHA:0:7}\" || git rev-parse --short HEAD) && npm run assemble && npm run generate:cv && next build",
    "build:local": "GALLERY_MODE=local npm run build",
    "sync": "npm run fetch:github && npm run assemble && npm run generate:cv",
    "start": "node ../scripts/dev-server.mjs next start",
    "lint": "node --require ./eslint-minimatch-compat.cjs ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "assemble": "GALLERY_MODE=r2 tsx ../scripts/assemble-cv-data.ts",
    "assemble:local": "GALLERY_MODE=local tsx ../scripts/assemble-cv-data.ts",
    "generate:cv": "tsx ../scripts/generate-cv.ts",
    "fetch:github": "node ../scripts/github-entry.mjs",
    "stats": "tsx ../scripts/count-technologies.ts",
    "dev:app": "GIT_COMMIT_HASH=$(git rev-parse --short HEAD) node ../scripts/dev-server.mjs next dev",
    "start:secrets": "python3 ../scripts/infisical/run.py start",
    "test:data": "tsx --test ../scripts/lib/data-utils.test.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.10.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "next": "16.4.5",
    "photoswipe": "^5.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.84",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "next": "$next",
    "postcss": "$postcss",
    "source-map-js": "1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    },
    "gray-matter": {
      "js-yaml": "4.3.2"
    },
    "eslint-plugin-react-hooks": {
      "zod": "4.6.6"
    },
    "zod@>=4 <4.6.6": "4.6.6",
    "fast-uri": "3.1.9",
    "@sentry/bundler-plugin-core@5.3.0": {
      "glob": "14.0.2"
    },
    "@sentry/bundler-plugins@10.75.3": {
      "glob": "14.0.2"
    },
    "@sentry/bundler-plugins@11": {
      "glob": "14.0.2"
    },
    "glob@14.0.2": {
      "path-scurry": "3.0.0"
    },
    "minimatch": {
      ".": "11.0.1",
      "@isaacs/nonrecursive-glob-match": "1.0.1"
    }
  }
}
